local function filterScripts()
	local query = string.lower(searchBar.Text)
	local visibleCount = 0
	for _, item in ipairs(scriptButtons) do
		local matchSearch = query == "" or string.find(string.lower(item.name), query, 1, true)
		local matchCat = activeCategory == "ALL" or item.cat == activeCategory
		if matchSearch and matchCat then
			item.btn.Visible = true
			visibleCount = visibleCount + 1
		else
			item.btn.Visible = false
		end
	end
	scriptsScroll.CanvasSize = UDim2.new(0, 0, 0, visibleCount * 46 + 20)
end

for cat, cb in pairs(catButtons) do
