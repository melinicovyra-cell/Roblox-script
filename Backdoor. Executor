minimizeBtn.MouseButton1Click:Connect(function()
	minimizeToken = minimizeToken + 1
	local myToken = minimizeToken
	minimized = not minimized
	if minimized then
		savedSize = mainFrame.Size
		-- сначала прячем контент, ПОТОМ сжимаем рамку (с защитой от nil)
		pcall(function() statusBar.Visible = false end)
		pcall(function() headerLine.Visible = false end)
		pcall(function()
			if pages then
				for _, page in pairs(pages) do
					page.Visible = false
				end
			end
		end)
		TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Size = UDim2.new(0, 650, 0, 52)}):Play()
	else
		-- сначала растягиваем, ПОТОМ показываем контент когда tween дойдёт
		TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = savedSize or UDim2.new(0, 650, 0, 480)}):Play()
		task.delay(0.3, function()
			if myToken ~= minimizeToken then return end
			if minimized then return end
			pcall(function() statusBar.Visible = true end)
			pcall(function() headerLine.Visible = true end)
			pcall(function()
				if activeTab and tabButtons and tabButtons[activeTab] then
					tabButtons[activeTab].page.Visible = true
				end
			end)
		end)
	end
end)

local function makeDraggable(obj, target)
	local dragging, dragStart, startPos
	obj.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = target.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			shadow.Position = UDim2.new(target.Position.X.Scale, target.Position.X.Offset - 15, target.Position.Y.Scale, target.Position.Y.Offset - 15)
		end
	end)
	UserInputService.InputEnded:Connect(function() dragging = false end)
end

