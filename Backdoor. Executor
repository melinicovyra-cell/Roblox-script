local function createTab(name, x, page, w)
	local b = Instance.new("TextButton", header)
	b.Size = UDim2.new(0, w or 68, 0, 28)
	b.Position = UDim2.new(0, x, 0, 11)
	b.BackgroundColor3 = Color3.fromRGB(40, 0, 0)
	b.Text = name
	b.TextColor3 = Color3.fromRGB(160, 160, 160)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 8
	round(b, 8)

	local underline = Instance.new("Frame", b)
	underline.Size = UDim2.new(0.6, 0, 0, 2)
	underline.Position = UDim2.new(0.2, 0, 1, -3)
	underline.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
	underline.BorderSizePixel = 0
	underline.Visible = false

	tabButtons[name] = {btn = b, line = underline, page = page}

	local defaultCol = Color3.fromRGB(40, 0, 0)
	local hoverCol = Color3.fromRGB(80, 0, 0)
	local activeCol = Color3.fromRGB(100, 10, 10)

	b.MouseEnter:Connect(function()
		if activeTab ~= name then
			TweenService:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = hoverCol}):Play()
		end
	end)
	b.MouseLeave:Connect(function()
		if activeTab ~= name then
			TweenService:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = defaultCol}):Play()
		end
	end)

	b.MouseButton1Click:Connect(function()
		if minimized then return end
		for tName, tData in pairs(tabButtons) do
			tData.page.Visible = false
			tData.line.Visible = false
			TweenService:Create(tData.btn, TweenInfo.new(0.2), {
				BackgroundColor3 = defaultCol,
				TextColor3 = Color3.fromRGB(160, 160, 160)
			}):Play()
		end
		page.Visible = true
		underline.Visible = true
		activeTab = name
		TweenService:Create(b, TweenInfo.new(0.2), {
			BackgroundColor3 = activeCol,
			TextColor3 = Color3.new(1, 1, 1)
		}):Play()
	end)
end

