local logOrder = 0

local function addLog(text, logType)
	logOrder = logOrder + 1
	local logColors = {
		success = Color3.fromRGB(0, 200, 0),
		error = Color3.fromRGB(255, 60, 60),
		info = Color3.fromRGB(120, 160, 255),
		warn = Color3.fromRGB(255, 200, 0),
		system = Color3.fromRGB(150, 150, 150),
	}
	local logPrefixes = {
		success = "[OK]",
		error = "[ERR]",
		info = "[INFO]",
		warn = "[WARN]",
		system = "[SYS]",
	}
	local col = logColors[logType] or logColors.info
	local prefix = logPrefixes[logType] or "[LOG]"
	local timestamp = os.date("%H:%M:%S")

	local line = Instance.new("TextLabel", consoleScroll)
	line.Size = UDim2.new(1, 0, 0, 18)
	line.BackgroundTransparency = 1
	line.RichText = true
	line.Text = string.format(
		'<font color="rgb(80,80,80)">%s</font> <font color="rgb(%d,%d,%d)">%s</font> %s',
		timestamp,
		math.floor(col.R * 255), math.floor(col.G * 255), math.floor(col.B * 255),
		prefix, text
	)
	line.TextColor3 = Color3.fromRGB(180, 180, 180)
	line.Font = Enum.Font.Code
	line.TextSize = 10
	line.TextXAlignment = Enum.TextXAlignment.Left
	line.LayoutOrder = logOrder
	task.defer(function()
		consoleScroll.CanvasPosition = Vector2.new(0, consoleScroll.AbsoluteCanvasSize.Y)
	end)
end

