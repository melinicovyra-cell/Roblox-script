local function notify(text, nType)
	notifOrder = notifOrder + 1
	local colors = {
		success = {bg = Color3.fromRGB(0, 50, 20), accent = Color3.fromRGB(50, 230, 120), glow = Color3.fromRGB(0, 255, 100)},
		error   = {bg = Color3.fromRGB(60, 0, 10),  accent = Color3.fromRGB(255, 80, 80),  glow = Color3.fromRGB(255, 50, 50)},
		info    = {bg = Color3.fromRGB(10, 25, 60), accent = Color3.fromRGB(100, 160, 255),glow = Color3.fromRGB(80, 140, 255)},
		warn    = {bg = Color3.fromRGB(60, 40, 0),  accent = Color3.fromRGB(255, 200, 60), glow = Color3.fromRGB(255, 180, 0)},
	}
	local c = colors[nType] or colors.info
	local DURATION = 3

	-- glow за фреймом (через ImageLabel с радиальной картинкой Roblox)
	local glow = Instance.new("ImageLabel", notifContainer)
	glow.Size = UDim2.new(1, 30, 0, 70)
	glow.Position = UDim2.new(0, -15, 0, -15)
	glow.BackgroundTransparency = 1
	glow.Image = "rbxassetid://5028857084" -- мягкое радиальное свечение
	glow.ImageColor3 = c.glow
	glow.ImageTransparency = 0.65
	glow.ZIndex = 200
	glow.LayoutOrder = notifOrder
	glow.Active = false

	-- основной фрейм поверх glow
	local frame = Instance.new("Frame", glow)
	frame.Size = UDim2.new(1, -30, 0, 44)
	frame.Position = UDim2.new(0, 15, 0, 15)
	frame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
	frame.BackgroundTransparency = 0
	frame.ZIndex = 201
	frame.ClipsDescendants = true
	round(frame, 10)

	-- внутренний градиент для глубины
	local fGrad = Instance.new("UIGradient", frame)
	fGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(28, 28, 34)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(14, 14, 18))
	})
	fGrad.Rotation = 90

	-- обводка с цветом акцента
	local nStroke = Instance.new("UIStroke", frame)
	nStroke.Color = c.accent
	nStroke.Thickness = 1.2
	nStroke.Transparency = 0.3
	nStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

	-- акцентная полоса слева (толще, ярче)
	local accentBar = Instance.new("Frame", frame)
	accentBar.Size = UDim2.new(0, 4, 1, -10)
	accentBar.Position = UDim2.new(0, 5, 0, 5)
	accentBar.BackgroundColor3 = c.accent
	accentBar.BorderSizePixel = 0
	accentBar.ZIndex = 202
	round(accentBar, 2)

	-- индикатор-кружок (без текста, цвет = тип уведомления)
	local iconBg = Instance.new("Frame", frame)
	iconBg.Size = UDim2.new(0, 14, 0, 14)
	iconBg.Position = UDim2.new(0, 22, 0.5, -7)
	iconBg.BackgroundColor3 = c.accent
	iconBg.BorderSizePixel = 0
	iconBg.ZIndex = 202
	round(iconBg, 7)
	-- внутренний светлый блик (даёт ощущение "светящейся точки")
	local iconHi = Instance.new("Frame", iconBg)
	iconHi.Size = UDim2.new(0, 5, 0, 5)
	iconHi.Position = UDim2.new(0, 3, 0, 3)
	iconHi.BackgroundColor3 = Color3.new(1, 1, 1)
	iconHi.BackgroundTransparency = 0.4
	iconHi.BorderSizePixel = 0
	iconHi.ZIndex = 203
	round(iconHi, 3)

	-- основной текст
	local nText = Instance.new("TextLabel", frame)
	nText.Size = UDim2.new(1, -50, 1, -8)
	nText.Position = UDim2.new(0, 44, 0, 2)
	nText.BackgroundTransparency = 1
	nText.Text = text
	nText.TextColor3 = Color3.fromRGB(230, 230, 235)
	nText.Font = Enum.Font.GothamMedium
	nText.TextSize = 12
	nText.TextXAlignment = Enum.TextXAlignment.Left
	nText.TextYAlignment = Enum.TextYAlignment.Center
	nText.TextTruncate = Enum.TextTruncate.AtEnd
	nText.ZIndex = 203

	-- прогресс-бар жизни уведомления внизу
	local progBg = Instance.new("Frame", frame)
	progBg.Size = UDim2.new(1, -16, 0, 2)
	progBg.Position = UDim2.new(0, 8, 1, -5)
	progBg.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
	progBg.BorderSizePixel = 0
	progBg.ZIndex = 202
	round(progBg, 1)

	local progFill = Instance.new("Frame", progBg)
	progFill.Size = UDim2.new(1, 0, 1, 0)
	progFill.BackgroundColor3 = c.accent
	progFill.BorderSizePixel = 0
	progFill.ZIndex = 203
	round(progFill, 1)

	-- появление: slide-in
	glow.Position = UDim2.new(0, -15 + 320, 0, -15)
	frame.BackgroundTransparency = 0.5
	TweenService:Create(glow, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = UDim2.new(0, -15, 0, -15)
	}):Play()
	TweenService:Create(frame, TweenInfo.new(0.35), {BackgroundTransparency = 0}):Play()

	-- прогресс-бар уезжает в 0
	TweenService:Create(progFill, TweenInfo.new(DURATION, Enum.EasingStyle.Linear), {
		Size = UDim2.new(0, 0, 1, 0)
	}):Play()

	-- лёгкая пульсация glow и точки-индикатора
	task.spawn(function()
		local t = 0
		while glow and glow.Parent do
			t = t + 0.05
			glow.ImageTransparency = 0.65 + math.sin(t) * 0.08
			if iconHi and iconHi.Parent then
				iconHi.BackgroundTransparency = 0.4 + math.sin(t * 1.5) * 0.2
			end
			task.wait(0.05)
		end
	end)

	task.delay(DURATION, function()
		if not glow or not glow.Parent then return end
		TweenService:Create(glow, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(0, -15 + 340, 0, -15),
			ImageTransparency = 1
		}):Play()
		TweenService:Create(frame, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
		TweenService:Create(nText, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
		TweenService:Create(nStroke, TweenInfo.new(0.3), {Transparency = 1}):Play()
		task.delay(0.4, function() if glow then glow:Destroy() end end)
	end)
end

