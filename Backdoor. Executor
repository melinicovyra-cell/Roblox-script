local function getHumanoid()
	local char = Players.LocalPlayer.Character
	return char and char:FindFirstChildOfClass("Humanoid") or nil
end

local function makeStatRow(props)
	-- props: {label, getter, setter, default, layoutOrder}
	local row = Instance.new("Frame", pages.RedPl)
	row.Size = UDim2.new(0.94, 0, 0, 42)
	row.BackgroundColor3 = Color3.fromRGB(22, 18, 24)
	row.BorderSizePixel = 0
	row.LayoutOrder = props.layoutOrder
	round(row, 8)

	local rowGrad = Instance.new("UIGradient", row)
	rowGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(36, 28, 38)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(18, 14, 22))
	})
	rowGrad.Rotation = 90

	local rowStroke = Instance.new("UIStroke", row)
	rowStroke.Color = Color3.fromRGB(120, 60, 80)
	rowStroke.Thickness = 1
	rowStroke.Transparency = 0.4

	-- акцентная полоска слева
	local rowAccent = Instance.new("Frame", row)
	rowAccent.Size = UDim2.new(0, 3, 0.65, 0)
	rowAccent.Position = UDim2.new(0, 6, 0.175, 0)
	rowAccent.BackgroundColor3 = Color3.fromRGB(255, 110, 130)
	rowAccent.BorderSizePixel = 0
	round(rowAccent, 2)

	-- название
	local rowLabel = Instance.new("TextLabel", row)
	rowLabel.Size = UDim2.new(0, 110, 1, 0)
	rowLabel.Position = UDim2.new(0, 16, 0, 0)
	rowLabel.BackgroundTransparency = 1
	rowLabel.Text = props.label
	rowLabel.TextColor3 = Color3.fromRGB(235, 235, 245)
	rowLabel.Font = Enum.Font.GothamBold
	rowLabel.TextSize = 11
	rowLabel.TextXAlignment = Enum.TextXAlignment.Left

	-- текущее значение (live)
	local liveValue = Instance.new("TextLabel", row)
	liveValue.Size = UDim2.new(0, 65, 0, 18)
	liveValue.Position = UDim2.new(0, 130, 0.5, -9)
	liveValue.BackgroundColor3 = Color3.fromRGB(35, 30, 40)
	liveValue.Text = "..."
	liveValue.TextColor3 = Color3.fromRGB(180, 200, 255)
	liveValue.Font = Enum.Font.Code
	liveValue.TextSize = 10
	round(liveValue, 4)
	Instance.new("UIStroke", liveValue).Color = Color3.fromRGB(80, 80, 130)

	-- TextBox для ввода нового значения
	local inputBg = Instance.new("Frame", row)
	inputBg.Size = UDim2.new(0, 70, 0, 24)
	inputBg.Position = UDim2.new(1, -150, 0.5, -12)
	inputBg.BackgroundColor3 = Color3.fromRGB(20, 16, 24)
	inputBg.BorderSizePixel = 0
	round(inputBg, 5)
	local inputStroke = Instance.new("UIStroke", inputBg)
	inputStroke.Color = Color3.fromRGB(140, 70, 90)
	inputStroke.Thickness = 1
	inputStroke.Transparency = 0.3

	local inputBox = Instance.new("TextBox", inputBg)
	inputBox.Size = UDim2.new(1, -8, 1, 0)
	inputBox.Position = UDim2.new(0, 4, 0, 0)
	inputBox.BackgroundTransparency = 1
	inputBox.Text = ""
	inputBox.PlaceholderText = tostring(props.default)
	inputBox.PlaceholderColor3 = Color3.fromRGB(100, 90, 110)
	inputBox.TextColor3 = Color3.fromRGB(255, 240, 240)
	inputBox.Font = Enum.Font.Code
	inputBox.TextSize = 11
	inputBox.ClearTextOnFocus = false
	inputBox.TextXAlignment = Enum.TextXAlignment.Center

	inputBox.Focused:Connect(function()
		TweenService:Create(inputStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(255, 110, 130), Transparency = 0, Thickness = 1.4}):Play()
	end)
	inputBox.FocusLost:Connect(function()
		TweenService:Create(inputStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(140, 70, 90), Transparency = 0.3, Thickness = 1}):Play()
	end)

	-- APPLY кнопка
	local applyBtn = Instance.new("TextButton", row)
	applyBtn.Size = UDim2.new(0, 60, 0, 24)
	applyBtn.Position = UDim2.new(1, -76, 0.5, -12)
	applyBtn.BackgroundColor3 = Color3.fromRGB(0, 110, 45)
	applyBtn.Text = "APPLY"
	applyBtn.TextColor3 = Color3.fromRGB(220, 255, 230)
	applyBtn.Font = Enum.Font.GothamBold
	applyBtn.TextSize = 10
	applyBtn.AutoButtonColor = false
	applyBtn.BorderSizePixel = 0
	round(applyBtn, 5)
	local applyGrad = Instance.new("UIGradient", applyBtn)
	applyGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(40, 180, 90)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 70, 25))
	})
	applyGrad.Rotation = 90
	local applyStroke = Instance.new("UIStroke", applyBtn)
	applyStroke.Color = Color3.fromRGB(80, 230, 130)
	applyStroke.Thickness = 1
	applyStroke.Transparency = 0.3
	local applyScale = Instance.new("UIScale", applyBtn)

	applyBtn.MouseEnter:Connect(function()
		TweenService:Create(applyStroke, TweenInfo.new(0.15), {Transparency = 0, Thickness = 1.4}):Play()
	end)
	applyBtn.MouseLeave:Connect(function()
		TweenService:Create(applyStroke, TweenInfo.new(0.15), {Transparency = 0.3, Thickness = 1}):Play()
	end)
	applyBtn.MouseButton1Down:Connect(function()
		TweenService:Create(applyScale, TweenInfo.new(0.08), {Scale = 0.9}):Play()
	end)
	applyBtn.MouseButton1Up:Connect(function()
		TweenService:Create(applyScale, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
	end)

	applyBtn.MouseButton1Click:Connect(function()
		local valStr = inputBox.Text
		if valStr == "" then
			valStr = inputBox.PlaceholderText
		end
		local num = tonumber(valStr)
		if not num then
			notify("Invalid number for " .. props.label, "error")
			return
		end
		local ok, err = pcall(function() props.setter(num) end)
		if ok then
			notify(props.label .. " = " .. tostring(num), "success")
			addLog("REDPL: " .. props.label .. " set to " .. tostring(num), "success")
		else
			notify("Failed: " .. tostring(err), "error")
		end
	end)

	-- live update текущего значения каждые 0.5 сек
	task.spawn(function()
		while liveValue and liveValue.Parent do
			local ok, val = pcall(props.getter)
			if ok and val ~= nil then
				liveValue.Text = tostring(math.floor(val * 10 + 0.5) / 10)
			else
				liveValue.Text = "n/a"
			end
			task.wait(0.5)
		end
	end)
end

