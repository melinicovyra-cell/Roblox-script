local function applyPersistColors(state, hover)
	-- state: nil=idle, true=persisted; hover: true=hover
	local grad
	if state then
		-- зелёные градиенты после успеха
		grad = ColorSequence.new({
			ColorSequenceKeypoint.new(0, hover and Color3.fromRGB(100, 240, 130) or Color3.fromRGB(70, 200, 100)),
			ColorSequenceKeypoint.new(0.5, hover and Color3.fromRGB(40, 160, 60) or Color3.fromRGB(20, 110, 35)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 50, 15))
		})
		persistStroke.Color = Color3.fromRGB(140, 255, 160)
		persistAccent.BackgroundColor3 = Color3.fromRGB(180, 255, 200)
		persistGlow.ImageColor3 = Color3.fromRGB(80, 255, 120)
		persistTextStroke.Color = Color3.fromRGB(0, 60, 20)
	else
		grad = ColorSequence.new({
			ColorSequenceKeypoint.new(0, hover and Color3.fromRGB(255, 200, 80) or Color3.fromRGB(255, 170, 50)),
			ColorSequenceKeypoint.new(0.5, hover and Color3.fromRGB(220, 140, 20) or Color3.fromRGB(190, 110, 10)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(100, 60, 0))
		})
		persistTextStroke.Color = Color3.fromRGB(80, 40, 0)
	end
	persistGrad.Color = grad
end

