-- ═══ HELPERS ═══
local function tw(o, p, t, s)
    TS:Create(o, TweenInfo.new(t or .18, s or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), p):Play()
end
local function mk(cls, pr, pa)
    local o = Instance.new(cls)
    for k, v in pairs(pr) do pcall(function() o[k] = v end) end
    if pa then o.Parent = pa end
    return o
end
local function cr(p, r) return mk("UICorner", {CornerRadius = UDim.new(0, r or 8)}, p) end
local function sk(p, col, th, tr) return mk("UIStroke", {Color = col or T.bd, Thickness = th or 1, Transparency = tr or .4}, p) end
local function pd(p, px)
    local u = Instance.new("UIPadding")
    u.PaddingLeft = UDim.new(0, px); u.PaddingRight = UDim.new(0, px)
    u.PaddingTop = UDim.new(0, px); u.PaddingBottom = UDim.new(0, px)
    u.Parent = p
end
local function hv(b, nm, ho, pr)
    pr = pr or "BackgroundColor3"
    b.MouseEnter:Connect(function() tw(b, {[pr] = ho}) end)
    b.MouseLeave:Connect(function() tw(b, {[pr] = nm}) end)
end

