local function runCmd(cmd, out)
    local args={}
    for a in cmd:gmatch("%S+") do table.insert(args,a) end
    local cc=args[1]
    if not cc or cc=="" then return end

    table.insert(cmdHistory, cmd)

    if cc=="help" then
        out("╔═══════════════════════════════════════════╗", T.accent)
        out("║       LuaOS Shell v3.0 — Справка         ║", T.accent)
        out("╠═══════════════════════════════════════════╣", T.accent)
        out("║  Файловая система:                        ║", T.accent2)
        out("║  ls [путь]    — список файлов             ║", T.text)
        out("║  cd [путь]    — сменить папку             ║", T.text)
        out("║  cat [файл]   — читать файл               ║", T.text)
        out("║  head [файл]  — первые 5 строк            ║", T.text)
        out("║  tail [файл]  — последние 5 строк         ║", T.text)
        out("║  echo [текст] — вывод / запись > файл     ║", T.text)
        out("║  touch [файл] — создать файл              ║", T.text)
        out("║  mkdir [папка]— создать папку              ║", T.text)
        out("║  rm [файл]    — удалить файл              ║", T.text)
        out("║  mv [a] [b]   — переместить               ║", T.text)
        out("║  cp [a] [b]   — копировать                ║", T.text)
        out("║  wc [файл]    — подсчёт строк/слов        ║", T.text)
        out("║  grep [слово] [файл] — поиск              ║", T.text)
        out("║  tree [путь]  — дерево файлов             ║", T.text)
        out("║  pwd          — текущая папка             ║", T.text)
        out("╠═══════════════════════════════════════════╣", T.accent2)
        out("║  Система:                                 ║", T.accent2)
        out("║  ps           — процессы                  ║", T.text)
        out("║  kill [pid]   — завершить процесс         ║", T.text)
        out("║  top          — нагрузка CPU/RAM          ║", T.text)
        out("║  mem          — использование RAM         ║", T.text)
        out("║  uptime       — время работы              ║", T.text)
        out("║  date         — дата и время              ║", T.text)
        out("║  whoami       — имя пользователя          ║", T.text)
        out("║  hostname     — имя хоста                 ║", T.text)
        out("║  uname        — версия ОС                 ║", T.text)
        out("║  neofetch     — системная информация      ║", T.text)
        out("║  history      — история команд            ║", T.text)
        out("║  fortune      — случайная цитата          ║", T.text)
        out("║  clear        — очистить экран            ║", T.text)
        out("║  exit         — закрыть терминал          ║", T.text)
        out("╚═══════════════════════════════════════════╝", T.accent)

    elseif cc=="neofetch" then
        local up=os.clock()-Kernel.boot
        local h=math.floor(up/3600)
        local m=math.floor(up%3600/60)
        local cnt=0; local mem=0
        for _,p in pairs(Kernel.procs) do cnt+=1; mem+=p.mem end

        out("", T.text)
        out("        ██╗     ██╗   ██╗ █████╗      "..player.Name.."@luaos", T.accent)
        out("        ██║     ██║   ██║██╔══██╗     ─────────────────", T.accent)
        out("        ██║     ██║   ██║███████║     OS:      LuaOS v3.0 Aurora", T.text)
        out("        ██║     ██║   ██║██╔══██║     Kernel:  Luau (Roblox)", T.text)
        out("        ███████╗╚██████╔╝██║  ██║     Uptime:  "..string.format("%02d:%02d", h, m), T.text)
        out("        ╚══════╝ ╚═════╝ ╚═╝  ╚═╝     Shell:   lsh 3.0", T.text)
        out("                                       Theme:   "..ActiveTheme, T.text)
        out("                                       Procs:   "..cnt, T.text)
        out("                                       RAM:     "..mem.."MB / 512MB", T.text)
        out("                                       Player:  "..player.DisplayName, T.text)
        out("                                       Game:    "..game.PlaceId, T.text)
        out("", T.text)
        -- Цветовая палитра
        local colors = "        "
        out(colors.."███ ███ ███ ███ ███ ███ ███ ███", T.accent)
        out("", T.text)

    elseif cc=="fortune" then
        out("🔮  "..Fortunes[math.random(#Fortunes)], T.yellow)

    elseif cc=="history" then
        out("  История команд:", T.accent)
        for i, cmd2 in ipairs(cmdHistory) do
            out(string.format("  %4d  %s", i, cmd2), T.text)
        end

    elseif cc=="tree" then
        local path = args[2] and fsResolve(args[2]) or CWD
        local function printTree(p, prefix)
            local nd = FS[p]
            if not nd or nd.t ~= "dir" then return end
            local ch = nd.children
            for i, cp in ipairs(ch) do
                local child = FS[cp]
                if not child then continue end
                local segs = cp:split("/")
                local nm = segs[#segs]
                local isLast = (i == #ch)
                local connector = isLast and "└── " or "├── "
                local icon = child.t == "dir" and "📁 " or "📄 "
                out(prefix .. connector .. icon .. nm, child.t == "dir" and T.accent2 or T.text)
                if child.t == "dir" then
                    local newPrefix = prefix .. (isLast and "    " or "│   ")
                    printTree(cp, newPrefix)
                end
            end
        end
        local segs = path:split("/")
        out("📂 " .. (segs[#segs] ~= "" and segs[#segs] or "/"), T.accent)
        printTree(path, "")

    elseif cc=="mkdir" then
        if not args[2] then out("mkdir: укажи имя папки", T.yellow); return end
        local ok, err = fsMkdir(args[2])
        if ok then
            out("Создана папка: "..fsResolve(args[2]), T.textDim)
        else
            out("mkdir: "..tostring(err), T.red)
        end

    elseif cc=="mv" then
        if not args[2] or not args[3] then out("mv: укажи источник и цель", T.yellow); return end
        local src = fsResolve(args[2])
        local dst = fsResolve(args[3])
        if not FS[src] then out("mv: "..args[2]..": не найден", T.red); return end
        FS[dst] = FS[src]
        FS[dst].time = os.time()
        FS[src] = nil
        -- Обновить родителей
        for _, nd in pairs(FS) do
            if nd.t == "dir" then
                for i, ch in ipairs(nd.children) do
                    if ch == src then nd.children[i] = dst; break end
                end
            end
        end
        out("Перемещено: "..src.." → "..dst, T.textDim)

    elseif cc=="cp" then
        if not args[2] or not args[3] then out("cp: укажи источник и цель", T.yellow); return end
        local src = fsResolve(args[2])
        local dst = fsResolve(args[3])
        if not FS[src] or FS[src].t ~= "file" then out("cp: "..args[2]..": файл не найден", T.red); return end
        fsWrite(dst, FS[src].content)
        out("Скопировано: "..src.." → "..dst, T.textDim)

    elseif cc=="grep" then
        if not args[2] or not args[3] then out("grep: использование: grep [слово] [файл]", T.yellow); return end
        local pattern = args[2]
        local content = fsRead(fsResolve(args[3]))
        if not content then out("grep: "..args[3]..": файл не найден", T.red); return end
        local found = 0
        for _, ln in ipairs(content:split("\n")) do
            if ln:lower():find(pattern:lower()) then
                out(ln, T.green)
                found += 1
            end
        end
        if found == 0 then out("(совпадений не найдено)", T.textDim) end

    elseif cc=="head" then
        if not args[2] then out("head: укажи файл", T.yellow); return end
        local content = fsRead(fsResolve(args[2]))
        if not content then out("head: файл не найден", T.red); return end
        local lines = content:split("\n")
        local count = tonumber(args[3]) or 5
        for i = 1, math.min(count, #lines) do
            out(lines[i], T.text)
        end

    elseif cc=="tail" then
        if not args[2] then out("tail: укажи файл", T.yellow); return end
        local content = fsRead(fsResolve(args[2]))
        if not content then out("tail: файл не найден", T.red); return end
        local lines = content:split("\n")
        local count = tonumber(args[3]) or 5
        for i = math.max(1, #lines - count + 1), #lines do
            out(lines[i], T.text)
        end

    elseif cc=="wc" then
        if not args[2] then out("wc: укажи файл", T.yellow); return end
        local content = fsRead(fsResolve(args[2]))
        if not content then out("wc: файл не найден", T.red); return end
        local lines = #content:split("\n")
        local words = 0
        for _ in content:gmatch("%S+") do words += 1 end
        local bytes = #content
        out(string.format("  %d строк  %d слов  %d байт  %s", lines, words, bytes, args[2]), T.text)

    elseif cc=="ls" then
        local path = args[2] and fsResolve(args[2]) or CWD
        local ch = fsList(path)
        if not ch then out("ls: "..path..": нет такого пути", T.red); return end
        if #ch==0 then out("(пусто)", T.textDim); return end
        out("  " .. path .. ":", T.accent)
        for _, cp in ipairs(ch) do
            local nd=FS[cp]
            if nd then
                local segs=cp:split("/")
                local nm=segs[#segs]
                if nd.t=="dir" then
                    out("  📁  "..nm.."/", T.accent2)
                else
                    out(string.format("  📄  %-26s %dB", nm, #nd.content), T.text)
                end
            end
        end

    elseif cc=="cd" then
        local p = args[2] and fsResolve(args[2]) or "/home/player"
        if FS[p] and FS[p].t=="dir" then
            CWD=p; out("→ "..CWD, T.textDim)
        else
            out("cd: "..tostring(args[2])..": нет такой директории", T.red)
        end

    elseif cc=="pwd" then
        out(CWD, T.text)

    elseif cc=="cat" then
        if not args[2] then out("cat: укажи файл", T.yellow); return end
        local content=fsRead(fsResolve(args[2]))
        if content then
            for _,ln in ipairs(content:split("\n")) do out(ln, T.text) end
        else
            out("cat: "..args[2]..": файл не найден", T.red)
        end

    elseif cc=="echo" then
        local full=table.concat(args," ",2)
        local lpart, rpart=full:match("^(.-)%s*>%s*(.+)$")
        if lpart and rpart then
            fsWrite(fsResolve(rpart), lpart.."\n")
            out("Записано → "..rpart, T.textDim)
        else
            out(full, T.text)
        end

    elseif cc=="touch" then
        if not args[2] then out("touch: укажи имя файла", T.yellow); return end
        local abs=fsResolve(args[2])
        if not FS[abs] then
            fsWrite(abs,""); out("Создан: "..abs, T.textDim)
        else
            out("Файл уже существует", T.textDim)
        end

    elseif cc=="rm" then
        if not args[2] then out("rm: укажи файл", T.yellow); return end
        local abs=fsResolve(args[2])
        if not FS[abs] then out("rm: файл не найден", T.red); return end
        if FS[abs].t=="dir" then out("rm: это директория (используй rm -r)", T.red); return end
        FS[abs]=nil
        for _, nd in pairs(FS) do
            if nd.t=="dir" then
                for i,ch in ipairs(nd.children) do
                    if ch==abs then table.remove(nd.children,i); break end
                end
            end
        end
        out("Удалён: "..abs, T.textDim)

    elseif cc=="ps" then
        out(string.format("  %-5s  %-22s  %-10s  %s","PID","ИМЯ","СТАТУС","RAM"), T.accent)
        out("  "..("─"):rep(52), T.textMut)
        local sorted={}
        for _,p in pairs(Kernel.procs) do table.insert(sorted,p) end
        table.sort(sorted,function(a,b) return a.pid<b.pid end)
        for _,p in ipairs(sorted) do
            out(string.format("  %-5s  %-22s  %-10s  %dMB",
                p.pid, p.name, p.state, p.mem), p.state=="running" and T.green or T.textDim)
        end

    elseif cc=="kill" then
        local pid=tonumber(args[2])
        if not pid then out("kill: укажи PID", T.yellow); return end
        local ok, err=kkill(pid)
        if ok then out("Процесс "..pid.." завершён ✓", T.green)
        else out("kill: "..tostring(err), T.red) end

    elseif cc=="top" then
        local total=512; local used=0; local cnt=0
        for _,p in pairs(Kernel.procs) do used+=p.mem; cnt+=1 end
        local pct=math.floor(used/total*100)
        local up=os.clock()-Kernel.boot
        out("── Системная нагрузка ──────────────────", T.accent)
        out(string.format("  Аптайм:    %.0f сек", up), T.text)
        out(string.format("  Процессов: %d", cnt), T.text)
        out(string.format("  RAM:       %d / %d MB (%d%%)", used, total, pct), T.text)
        local bar=("█"):rep(math.floor(pct/5))..("░"):rep(20-math.floor(pct/5))
        out("  ["..bar.."]", pct>80 and T.red or pct>50 and T.yellow or T.green)

    elseif cc=="mem" then
        local total=512; local used=0
        for _,p in pairs(Kernel.procs) do used+=p.mem end
        local pct=math.floor(used/total*100)
        out(string.format("RAM: %dMB / %dMB  (%d%% занято)", used, total, pct), T.text)
        out("["..("█"):rep(math.floor(pct/5))..("░"):rep(20-math.floor(pct/5)).."]", pct>80 and T.red or T.accent)

    elseif cc=="uptime" then
        local up=os.clock()-Kernel.boot
        out(string.format("Аптайм: %02d:%02d:%02d", math.floor(up/3600), math.floor(up%3600/60), math.floor(up%60)), T.text)

    elseif cc=="date" then
        out(os.date("Дата: %d.%m.%Y   Время: %H:%M:%S"), T.text)

    elseif cc=="whoami" then out(player.Name, T.text)
    elseif cc=="hostname" then out(fsRead("/etc/hostname") or "luaos", T.text)
    elseif cc=="uname" then out("LuaOS 3.0.0 Aurora (Luau/"..os.date("%Y")..") enhanced-edition", T.text)
    elseif cc=="clear" then return "clear"
    elseif cc=="exit" then return "exit"
    else
        out("lsh: "..cc..": команда не найдена. Напиши 'help'", T.red)
    end
end

