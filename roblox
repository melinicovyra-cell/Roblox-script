    local outS = mk("ScrollingFrame", {Size = UDim2.new(1, 0, 1, -42), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = T.ac, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(0, 0, 0, 0), ZIndex = z + 2}, tbg)
    mk("UIListLayout", {Padding = UDim.new(0, 1)}, outS); pd(outS, 8)

    local function addO(txt, col)
        local lb = mk("TextLabel", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = txt, Font = Enum.Font.Code, TextSize = 13, TextColor3 = col or T.tt, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, ZIndex = z + 3}, outS)
        task.defer(function() outS.CanvasPosition = Vector2.new(0, outS.AbsoluteCanvasSize.Y) end)
        return lb
    end

    -- FIX: Строка ввода — промпт и поле ввода правильно разделены
    local inRow = mk("Frame", {Size = UDim2.new(1, 0, 0, 42), Position = UDim2.new(0, 0, 1, -42), BackgroundColor3 = Color3.fromRGB(12, 14, 28), BorderSizePixel = 0, ZIndex = z + 2}, tbg)
    mk("Frame", {Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = T.ac, BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = z + 3}, inRow)

    local prompt = mk("TextLabel", {
        Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
        Position = UDim2.new(0, 8, 0, 0), BackgroundTransparency = 1,
        Text = P.Name .. "@luaos:~$ ", Font = Enum.Font.Code, TextSize = 13,
        TextColor3 = T.ac2, ZIndex = z + 3,
    }, inRow)

    -- FIX: Поле ввода привязано к правому краю промпта
    local inBox = mk("TextBox", {
        Size = UDim2.new(1, -8, 1, -6), Position = UDim2.new(0, 0, 0, 3),
        BackgroundTransparency = 1, Text = "", PlaceholderText = "",
        PlaceholderColor3 = T.txm, Font = Enum.Font.Code, TextSize = 13,
        TextColor3 = T.tt, TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false, ZIndex = z + 3,
    }, inRow)

    -- Контейнер чтобы поле было правее промпта
    task.defer(function()
        local pw = prompt.AbsoluteSize.X + 12
        inBox.Size = UDim2.new(1, -pw, 1, -6)
        inBox.Position = UDim2.new(0, pw, 0, 3)
    end)

    addO("  LuaOS Terminal v3.1 Aurora", T.ac)
    addO("  Ядро: Luau  |  Платформа: Roblox", T.txd)
    addO("  help — справка  |  neofetch — сведения", T.txd)
    addO("", T.tx)
    addO(fsRead("/etc/motd") or "", T.tx)

    local hist, hidx = {}, 0

    inBox.FocusLost:Connect(function(enter)
        if not enter then return end
        local cmd2 = inBox.Text; inBox.Text = ""
        if cmd2 == "" then return end
        table.insert(hist, cmd2); hidx = #hist + 1
        addO(P.Name .. "@luaos:" .. CWD .. "$ " .. cmd2, T.txd)
        local r = runCmd(cmd2, addO)
        if r == "clear" then
            for _, ch in ipairs(outS:GetChildren()) do if ch:IsA("TextLabel") then ch:Destroy() end end
        elseif r == "exit" then
            win:Destroy(); WINS["Терминал"] = nil
            if WinProcs["Терминал"] then kkill(WinProcs["Терминал"]); WinProcs["Терминал"] = nil end
            for i, v in ipairs(OpenWinList) do if v.title == "Терминал" then table.remove(OpenWinList, i); break end end
            if refreshTB then refreshTB() end
        end
        prompt.Text = P.Name .. "@luaos:" .. CWD .. "$ "
        task.defer(function()
            local pw = prompt.AbsoluteSize.X + 12
            inBox.Size = UDim2.new(1, -pw, 1, -6)
            inBox.Position = UDim2.new(0, pw, 0, 3)
            inBox:CaptureFocus()
        end)
    end)

    UIS.InputBegan:Connect(function(i, gpe)
        if gpe or not inBox:IsFocused() then return end
        if i.KeyCode == Enum.KeyCode.Up then hidx = math.max(1, hidx - 1); inBox.Text = hist[hidx] or ""
        elseif i.KeyCode == Enum.KeyCode.Down then hidx = math.min(#hist + 1, hidx + 1); inBox.Text = hist[hidx] or "" end
    end)
    task.defer(function() inBox:CaptureFocus() end)
end

