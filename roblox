    -- Анимация
    win.Size = UDim2.new(0, w * 0.95, 0, 0)
    win.BackgroundTransparency = 0.5
    tw(win, {Size = UDim2.new(0, w, 0, h), BackgroundTransparency = 0}, .25, Enum.EasingStyle.Back)

    WINS[title] = win
    WinProcs[title] = procId
    table.insert(OpenWinList, {title = title, ico = ico or ""})
    if refreshTB then refreshTB() end

    return win, body, z
end

