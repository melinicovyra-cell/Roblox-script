                    TextSize=10, ZIndex=z+4, BorderSizePixel=0},row)
                corner(kb,4)
                kb.MouseButton1Click:Connect(function()
                    kkill(p.pid)
                    notify("Менеджер задач", "Процесс "..p.name.." завершён", 3, "📊")
                end)
            end

            table.insert(rows,row)
        end
    end

    local statBar=c("Frame",{
        Size=UDim2.new(1,0,0,46), Position=UDim2.new(0,0,1,-46),
        BackgroundColor3=T.winTitle, BorderSizePixel=0,ZIndex=z+2},bg)

    local statLbl=c("TextLabel",{
        Size=UDim2.new(1,-16,1,0),Position=UDim2.new(0,8,0,0),
        BackgroundTransparency=1,Text="",
        Font=Enum.Font.Code,TextSize=11,TextColor3=T.textDim,
        TextXAlignment=Enum.TextXAlignment.Left, RichText=true,ZIndex=z+3},statBar)

    local ramBg=c("Frame",{
        Size=UDim2.new(1,-16,0,4),Position=UDim2.new(0,8,0,38),
        BackgroundColor3=T.surface,BorderSizePixel=0,ZIndex=z+2},statBar)
    corner(ramBg,2)
    local ramBar=c("Frame",{
        Size=UDim2.new(0,0,0,4),Position=UDim2.new(0,8,0,38),
        BackgroundColor3=T.accent,BorderSizePixel=0,ZIndex=z+3},statBar)
    corner(ramBar,2)

    local conn=RunService.Heartbeat:Connect(function()
        local total=512; local used=0; local cnt=0
        for _,p in pairs(Kernel.procs) do used+=p.mem; cnt+=1 end
        local pct=math.floor(used/total*100)
        statLbl.Text=string.format("Процессов: %d  │  RAM: %dMB/%dMB (%d%%)  │  ▲ %ds",
            cnt, used, total, pct, math.floor(os.clock()-Kernel.boot))
        tw(ramBar,{Size=UDim2.new(used/total,0,0,4)},.3)
        ramBar.BackgroundColor3=pct>80 and T.red or pct>50 and T.yellow or T.accent
    end)

    task.spawn(function()
        while win and win.Parent do refresh(); task.wait(0.5) end
        conn:Disconnect()
    end)
    refresh()
end

