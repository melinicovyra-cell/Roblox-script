        Size = UDim2.new(1, -120, 1, 0), Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1, Text = (ico or "") .. "  " .. title,
        Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = T.tx,
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = z + 2,
    }, bar)

    -- Кнопки окна (Windows-style: ─ □ ✕)
    local mini, maxi = false, false
    local origSize = UDim2.new(0, w, 0, h)
    local origPos = UDim2.new(0, x or 180, 0, y or 80)
    local body

    local function wBtn(text, xoff, bgCol, hCol, cb)
        local b = mk("TextButton", {
            Size = UDim2.new(0, 36, 0, 28), Position = UDim2.new(1, xoff, 0, 4),
            BackgroundColor3 = bgCol, BackgroundTransparency = 0.5,
            Text = text, TextColor3 = T.tx, Font = Enum.Font.GothamBold,
            TextSize = 14, ZIndex = z + 3, BorderSizePixel = 0,
        }, bar)
        cr(b, 6)
        b.MouseEnter:Connect(function() tw(b, {BackgroundTransparency = 0, BackgroundColor3 = hCol}) end)
        b.MouseLeave:Connect(function() tw(b, {BackgroundTransparency = 0.5, BackgroundColor3 = bgCol}) end)
        b.MouseButton1Click:Connect(cb)
        return b
    end

    -- Закрыть
    wBtn("✕", -40, T.sf2, T.cl, function()
        tw(win, {BackgroundTransparency = 1, Size = UDim2.new(0, w * 0.95, 0, 0)}, .2)
        task.delay(.25, function()
            win:Destroy()
            WINS[title] = nil
            -- FIX: убиваем процесс при закрытии окна
            if WinProcs[title] then kkill(WinProcs[title]); WinProcs[title] = nil end
            -- FIX: убираем из списка открытых
            for i, v in ipairs(OpenWinList) do
                if v.title == title then table.remove(OpenWinList, i); break end
            end
            if refreshTB then refreshTB() end
        end)
    end)

    -- Развернуть
    wBtn("□", -78, T.sf2, T.mx, function()
        if maxi then
            tw(win, {Size = origSize, Position = origPos}, .2)
            maxi = false
        else
            origPos = win.Position; origSize = win.Size
            tw(win, {Size = UDim2.new(1, 0, 1, -46), Position = UDim2.new(0, 0, 0, 0)}, .2)
            maxi = true
        end
        if mini then mini = false; if body then body.Visible = true end end
    end)

    -- Свернуть
    wBtn("─", -116, T.sf2, T.mn, function()
        if mini then
            tw(win, {Size = maxi and UDim2.new(1, 0, 1, -46) or origSize}, .2)
            if body then body.Visible = true end
            mini = false
        else
            tw(win, {Size = UDim2.new(0, w, 0, 36)}, .2)
