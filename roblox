local function fsResolve(path)
    if path == "~" then return "/home/player" end
    if path:sub(1, 2) == "~/" then path = "/home/player/" .. path:sub(3) end
    if path:sub(1, 1) ~= "/" then path = (CWD == "/" and "/" .. path) or (CWD .. "/" .. path) end
    local pts = {}
    for seg in path:gmatch("[^/]+") do
        if seg == ".." then table.remove(pts) elseif seg ~= "." then table.insert(pts, seg) end
    end
    return (#pts == 0 and "/") or ("/" .. table.concat(pts, "/"))
end
local function fsRead(path)
    local nd = FS[fsResolve(path)]
    return nd and nd.t == "file" and nd.content or nil
end
local function fsWrite(path, content)
    local abs = fsResolve(path)
    if FS[abs] then FS[abs].content = content; FS[abs].time = os.time()
    else
        FS[abs] = fsN("file", content)
        local pp = abs:match("(.+)/[^/]+$") or "/"
        if FS[pp] and FS[pp].t == "dir" then table.insert(FS[pp].children, abs) end
    end
end
local function fsList(path)
    local nd = FS[fsResolve(path)]
    return nd and nd.t == "dir" and nd.children or nil
end
local function fsMkdir(path)
    local abs = fsResolve(path)
    if FS[abs] then return false end
    FS[abs] = fsN("dir")
    local pp = abs:match("(.+)/[^/]+$") or "/"
    if FS[pp] and FS[pp].t == "dir" then table.insert(FS[pp].children, abs) end
    return true
end

