            BackgroundColor3=col,
            Text="", ZIndex=z+3, BorderSizePixel=0,
        }, bar)
        corner(b,7)
        local lbl=c("TextLabel", {
            Size=UDim2.new(1,0,1,0),
            BackgroundTransparency=1,
            Text=sym, TextColor3=Color3.new(0,0,0),
            Font=Enum.Font.GothamBold, TextSize=9,
