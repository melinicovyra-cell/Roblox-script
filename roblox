    wbtn(T.close, -22, "✕", function()
        tw(win,{Size=UDim2.new(0,w,0,0),BackgroundTransparency=1},.2)
        task.delay(.25, function()
            win:Destroy()
            WINS[title]=nil
            OpenWinNames[title]=nil
            if refreshTaskbar then refreshTaskbar() end
        end)
    end)

    -- Свернуть
    wbtn(T.minimize, -40, "─", function()
        if mini then
            tw(win,{Size=orig},.2)
            if body then body.Visible=true end
            mini=false
        else
            tw(win,{Size=UDim2.new(0,w,0,38)},.2)
            task.delay(.15,function()
                if body then body.Visible=false end
            end)
            mini=true
        end
    end)

    -- Развернуть (НОВОЕ)
    wbtn(T.maximize, -58, "□", function()
        if maxi then
            tw(win,{Size=orig, Position=origPos},.25)
            maxi=false
        else
            origPos=win.Position
            orig=win.Size
            tw(win,{Size=UDim2.new(1,0,1,-44), Position=UDim2.new(0,0,0,0)},.25)
            maxi=true
        end
        if mini then
            mini=false
            if body then body.Visible=true end
        end
    end)

    -- Заголовок текст
    c("TextLabel", {
        Size=UDim2.new(1,-120,1,0),
        Position=UDim2.new(0,14,0,0),
        BackgroundTransparency=1,
        Text=title, Font=Enum.Font.GothamBold,
        TextSize=13, TextColor3=T.text,
        TextXAlignment=Enum.TextXAlignment.Left,
        ZIndex=z+2,
    }, bar)

    body = c("Frame", {
        Size=UDim2.new(1,0,1,-38),
        Position=UDim2.new(0,0,0,38),
        BackgroundTransparency=1,
        ZIndex=z+1, ClipsDescendants=true,
    }, win)

    makeDrag(bar, win)

    -- Анимация появления
    win.Size=UDim2.new(0,w,0,0)
    win.BackgroundTransparency=1
    tw(win,{Size=UDim2.new(0,w,0,h), BackgroundTransparency=0},.25,Enum.EasingStyle.Back)

    WINS[title]=win
    OpenWinNames[title]=true
    if refreshTaskbar then refreshTaskbar() end

    return win, body, z
end

