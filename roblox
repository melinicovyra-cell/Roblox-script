}

local function runCmd(cmd, out)
    local args = {}
    for a in cmd:gmatch("%S+") do table.insert(args, a) end
    local c2 = args[1]
    if not c2 or c2 == "" then return end
    table.insert(cmdHist, cmd)

    if c2 == "help" then
        out("╔════════════════════════════════════════╗", T.ac)
        out("║     LuaOS Shell v3.1 — Справка        ║", T.ac)
        out("╠════════════════════════════════════════╣", T.ac)
        out("║ ls cd cat head tail echo touch mkdir   ║", T.tx)
        out("║ rm mv cp wc grep tree pwd              ║", T.tx)
        out("║ ps kill top mem uptime date             ║", T.tx)
        out("║ whoami hostname uname neofetch          ║", T.tx)
        out("║ history fortune clear exit              ║", T.tx)
        out("╚════════════════════════════════════════╝", T.ac)

    elseif c2 == "neofetch" then
        local up = os.clock() - Kernel.boot
        local cnt, mem = 0, 0
        for _, p in pairs(Kernel.procs) do cnt += 1; mem += p.mem end
        out("", T.tx)
        out("   ██╗     ██╗   ██╗ █████╗     " .. P.Name .. "@luaos", T.ac)
        out("   ██║     ██║   ██║██╔══██╗    ──────────────────", T.ac)
        out("   ██║     ██║   ██║███████║    OS:     LuaOS 3.1 Aurora", T.tx)
        out("   ██║     ██║   ██║██╔══██║    Kernel: Luau (Roblox)", T.tx)
        out("   ███████╗╚██████╔╝██║  ██║    Up:     " .. string.format("%02d:%02d", math.floor(up / 3600), math.floor(up % 3600 / 60)), T.tx)
        out("   ╚══════╝ ╚═════╝ ╚═╝  ╚═╝    Shell:  lsh 3.1", T.tx)
        out("                                 Theme:  " .. AT, T.tx)
        out("                                 Procs:  " .. cnt, T.tx)
        out("                                 RAM:    " .. mem .. "MB/512MB", T.tx)
        out("                                 Player: " .. P.DisplayName, T.tx)
        out("", T.tx)

    elseif c2 == "fortune" then out("  " .. Fortunes[math.random(#Fortunes)], T.yw)
    elseif c2 == "history" then
        for i, cm in ipairs(cmdHist) do out(string.format("  %3d  %s", i, cm), T.tx) end

    elseif c2 == "tree" then
        local path = args[2] and fsResolve(args[2]) or CWD
        local function pTree(p3, pf)
            local nd = FS[p3]; if not nd or nd.t ~= "dir" then return end
            for i, cp in ipairs(nd.children) do
                local ch = FS[cp]; if not ch then continue end
                local nm = cp:match("[^/]+$")
                local last = (i == #nd.children)
                out(pf .. (last and "└── " or "├── ") .. (ch.t == "dir" and "📁 " or "📄 ") .. nm, ch.t == "dir" and T.ac2 or T.tx)
                if ch.t == "dir" then pTree(cp, pf .. (last and "    " or "│   ")) end
            end
        end
        out("📂 " .. (path:match("[^/]+$") or "/"), T.ac)
        pTree(path, "")

    elseif c2 == "mkdir" then
        if not args[2] then out("mkdir: укажи папку", T.yw); return end
        if fsMkdir(args[2]) then out("Создана: " .. fsResolve(args[2]), T.txd) else out("mkdir: уже существует", T.rd) end

    elseif c2 == "mv" then
        if not args[2] or not args[3] then out("mv: укажи src dst", T.yw); return end
        local src, dst = fsResolve(args[2]), fsResolve(args[3])
        if not FS[src] then out("mv: не найден", T.rd); return end
        FS[dst] = FS[src]; FS[src] = nil
        for _, nd in pairs(FS) do if nd.t == "dir" then for i, ch in ipairs(nd.children) do if ch == src then nd.children[i] = dst end end end end
        out(src .. " → " .. dst, T.txd)

    elseif c2 == "cp" then
        if not args[2] or not args[3] then out("cp: укажи src dst", T.yw); return end
        local src = fsResolve(args[2])
        if not FS[src] or FS[src].t ~= "file" then out("cp: не найден", T.rd); return end
        fsWrite(fsResolve(args[3]), FS[src].content)
        out("Скопировано", T.txd)

    elseif c2 == "grep" then
        if not args[2] or not args[3] then out("grep: grep [слово] [файл]", T.yw); return end
        local co = fsRead(fsResolve(args[3]))
        if not co then out("Файл не найден", T.rd); return end
        local f = 0
        for _, ln in ipairs(co:split("\n")) do if ln:lower():find(args[2]:lower()) then out(ln, T.gn); f += 1 end end
        if f == 0 then out("(не найдено)", T.txd) end

    elseif c2 == "head" then
        if not args[2] then out("head: укажи файл", T.yw); return end
        local co = fsRead(fsResolve(args[2]))
        if not co then out("Не найден", T.rd); return end
        local ls = co:split("\n"); for i = 1, math.min(5, #ls) do out(ls[i], T.tx) end

    elseif c2 == "tail" then
        if not args[2] then out("tail: укажи файл", T.yw); return end
        local co = fsRead(fsResolve(args[2]))
        if not co then out("Не найден", T.rd); return end
        local ls = co:split("\n"); for i = math.max(1, #ls - 4), #ls do out(ls[i], T.tx) end

    elseif c2 == "wc" then
        if not args[2] then out("wc: укажи файл", T.yw); return end
        local co = fsRead(fsResolve(args[2]))
        if not co then out("Не найден", T.rd); return end
        local w = 0; for _ in co:gmatch("%S+") do w += 1 end
        out(string.format("  %d строк  %d слов  %dB", #co:split("\n"), w, #co), T.tx)

    elseif c2 == "ls" then
        local path = args[2] and fsResolve(args[2]) or CWD
        local ch = fsList(path)
        if not ch then out("ls: не найден", T.rd); return end
        if #ch == 0 then out("(пусто)", T.txd); return end
        for _, cp in ipairs(ch) do
            local nd = FS[cp]; if not nd then continue end
            local nm = cp:match("[^/]+$")
            if nd.t == "dir" then out("  📁 " .. nm .. "/", T.ac2)
            else out(string.format("  📄 %-24s %dB", nm, #nd.content), T.tx) end
        end

    elseif c2 == "cd" then
        local p = args[2] and fsResolve(args[2]) or "/home/player"
        if FS[p] and FS[p].t == "dir" then CWD = p; out("→ " .. CWD, T.txd)
        else out("cd: не найден", T.rd) end

    elseif c2 == "pwd" then out(CWD, T.tx)
    elseif c2 == "cat" then
        if not args[2] then out("cat: укажи файл", T.yw); return end
        local co = fsRead(fsResolve(args[2]))
        if co then for _, l in ipairs(co:split("\n")) do out(l, T.tx) end
        else out("Не найден", T.rd) end

    elseif c2 == "echo" then
        local full = table.concat(args, " ", 2)
        local l, r = full:match("^(.-)%s*>%s*(.+)$")
        if l and r then fsWrite(fsResolve(r), l .. "\n"); out("→ " .. r, T.txd)
        else out(full, T.tx) end

    elseif c2 == "touch" then
        if not args[2] then out("touch: укажи файл", T.yw); return end
        local abs = fsResolve(args[2])
        if not FS[abs] then fsWrite(abs, ""); out("Создан: " .. abs, T.txd) else out("Существует", T.txd) end

    elseif c2 == "rm" then
        if not args[2] then out("rm: укажи файл", T.yw); return end
        local abs = fsResolve(args[2])
        if not FS[abs] then out("Не найден", T.rd); return end
        if FS[abs].t == "dir" then out("Это папка", T.rd); return end
        FS[abs] = nil
        for _, nd in pairs(FS) do if nd.t == "dir" then for i, ch in ipairs(nd.children) do if ch == abs then table.remove(nd.children, i); break end end end end
        out("Удалён", T.txd)

    elseif c2 == "ps" then
        out(string.format("  %-4s %-18s %-8s %s", "PID", "ИМЯ", "СТАТУС", "RAM"), T.ac)
        local sorted = {}; for _, p in pairs(Kernel.procs) do table.insert(sorted, p) end
        table.sort(sorted, function(a, b) return a.pid < b.pid end)
        for _, p in ipairs(sorted) do
            out(string.format("  %-4d %-18s %-8s %dMB", p.pid, p.name, p.state, p.mem), p.state == "running" and T.gn or T.txd)
        end

    elseif c2 == "kill" then
        local pid = tonumber(args[2])
        if not pid then out("kill: PID?", T.yw); return end
        local ok, err = kkill(pid)
        if ok then out("OK ✓", T.gn) else out("kill: " .. tostring(err), T.rd) end

    elseif c2 == "top" then
        local used, cnt = 0, 0
        for _, p in pairs(Kernel.procs) do used += p.mem; cnt += 1 end
        local pct = math.floor(used / 512 * 100)
        out(string.format("  Procs: %d  RAM: %d/512MB (%d%%)", cnt, used, pct), T.tx)
        local bar = ("█"):rep(math.floor(pct / 5)) .. ("░"):rep(20 - math.floor(pct / 5))
        out("  [" .. bar .. "]", pct > 80 and T.rd or pct > 50 and T.yw or T.gn)

    elseif c2 == "mem" then
        local used = 0; for _, p in pairs(Kernel.procs) do used += p.mem end
        out(string.format("RAM: %dMB / 512MB", used), T.tx)

    elseif c2 == "uptime" then
        local u = os.clock() - Kernel.boot
        out(string.format("Up: %02d:%02d:%02d", math.floor(u / 3600), math.floor(u % 3600 / 60), math.floor(u % 60)), T.tx)

    elseif c2 == "date" then out(os.date("%d.%m.%Y  %H:%M:%S"), T.tx)
    elseif c2 == "whoami" then out(P.Name, T.tx)
    elseif c2 == "hostname" then out(fsRead("/etc/hostname") or "luaos", T.tx)
    elseif c2 == "uname" then out("LuaOS 3.1.0 Aurora (Luau) enhanced", T.tx)
    elseif c2 == "clear" then return "clear"
    elseif c2 == "exit" then return "exit"
    else out("lsh: " .. c2 .. ": не найдено. help", T.rd) end
end

