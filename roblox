    local disp = mk("TextLabel", {Size = UDim2.new(1, -12, 0, 60), Position = UDim2.new(0, 6, 0, 6), BackgroundColor3 = T.sf, Text = "0", Font = Enum.Font.Code, TextSize = 28, TextColor3 = T.tx, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = z + 2, BorderSizePixel = 0}, bg)
    cr(disp, 8); pd(disp, 10)
    local expr = ""
    local btns = {{"C", "⌫", "%", "÷"}, {"7", "8", "9", "×"}, {"4", "5", "6", "-"}, {"1", "2", "3", "+"}, {"±", "0", ".", "="}}
    local grid = mk("Frame", {Size = UDim2.new(1, -12, 1, -80), Position = UDim2.new(0, 6, 0, 74), BackgroundTransparency = 1, ZIndex = z + 1}, bg)
    for ri, row in ipairs(btns) do
        for ci, lb in ipairs(row) do
            local isOp = lb == "÷" or lb == "×" or lb == "-" or lb == "+" or lb == "="
            local isSp = lb == "C" or lb == "⌫" or lb == "%" or lb == "±"
            local bc = isOp and T.acd or isSp and T.sf2 or T.sf
            local b = mk("TextButton", {Size = UDim2.new(0.25, -4, 0.2, -4), Position = UDim2.new((ci - 1) * 0.25, 2, (ri - 1) * 0.2, 2), BackgroundColor3 = bc, Text = lb, Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = isOp and Color3.new(1, 1, 1) or T.tx, ZIndex = z + 2, BorderSizePixel = 0}, grid)
            cr(b, 8)
            b.MouseButton1Click:Connect(function()
                if lb == "C" then expr = ""
                elseif lb == "⌫" then expr = expr:sub(1, -2)
                elseif lb == "±" then expr = expr:sub(1, 1) == "-" and expr:sub(2) or "-" .. expr
                elseif lb == "=" then
                    local ev = expr:gsub("×", "*"):gsub("÷", "/")
                    local fn = loadstring("return " .. ev)
                    if fn then local ok, r = pcall(fn); expr = ok and tostring(r) or "Ошибка" else expr = "Ошибка" end
                else expr = expr .. lb end
                disp.Text = expr == "" and "0" or expr
            end)
        end
    end
end

