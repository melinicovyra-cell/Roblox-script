    local cols = {{t = "PID", w = .10}, {t = "Процесс", w = .36}, {t = "Статус", w = .22}, {t = "RAM", w = .16}, {t = "", w = .16}}
    local xp = 0
    for _, cl in ipairs(cols) do
        mk("TextLabel", {Size = UDim2.new(cl.w, 0, 1, 0), Position = UDim2.new(xp, 6, 0, 0), BackgroundTransparency = 1, Text = cl.t, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = T.ac2, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = z + 3}, hdr)
        xp += cl.w
    end

    local list = mk("ScrollingFrame", {Size = UDim2.new(1, 0, 1, -72), Position = UDim2.new(0, 0, 0, 28), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = T.ac, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(0, 0, 0, 0), ZIndex = z + 2}, bg)
    mk("UIListLayout", {Padding = UDim.new(0, 2)}, list); pd(list, 4)
    local rows = {}

    local function refresh()
        for _, r in ipairs(rows) do r:Destroy() end; rows = {}
        local sorted = {}; for _, p in pairs(Kernel.procs) do table.insert(sorted, p) end
        table.sort(sorted, function(a, b) return a.pid < b.pid end)
        for i, p in ipairs(sorted) do
            local row = mk("Frame", {Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = i % 2 == 0 and T.sf2 or T.sf, BorderSizePixel = 0, ZIndex = z + 3}, list)
            cr(row, 4)
            local datas = {tostring(p.pid), p.name, p.state, p.mem .. "MB"}
            local xp2 = 0
            for ci, cl in ipairs(cols) do
                if ci <= 4 then
                    mk("TextLabel", {Size = UDim2.new(cl.w, 0, 1, 0), Position = UDim2.new(xp2, 6, 0, 0), BackgroundTransparency = 1, Text = datas[ci], Font = Enum.Font.Code, TextSize = 11, TextColor3 = ci == 3 and (p.state == "running" and T.gn or T.txd) or T.tx, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = z + 4}, row)
                end
                xp2 += cl.w
            end
            if not p.sys then
                local kb = mk("TextButton", {Size = UDim2.new(0, 40, 0, 18), Position = UDim2.new(.84, 0, 0.5, -9), BackgroundColor3 = T.rd, Text = "Kill", TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 10, ZIndex = z + 4, BorderSizePixel = 0}, row)
                cr(kb, 4)
                kb.MouseButton1Click:Connect(function() kkill(p.pid) end)
            end
            table.insert(rows, row)
        end
    end

    local stBar = mk("Frame", {Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 1, -40), BackgroundColor3 = T.wt, BorderSizePixel = 0, ZIndex = z + 2}, bg)
    local stLbl = mk("TextLabel", {Size = UDim2.new(1, -8, 1, 0), Position = UDim2.new(0, 6, 0, 0), BackgroundTransparency = 1, Text = "", Font = Enum.Font.Code, TextSize = 11, TextColor3 = T.txd, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = z + 3}, stBar)

    task.spawn(function()
        while win and win.Parent do
            refresh()
            local used, cnt = 0, 0
            for _, p in pairs(Kernel.procs) do used += p.mem; cnt += 1 end
            stLbl.Text = string.format("Процессов: %d | RAM: %dMB/512MB (%d%%) | ▲ %ds", cnt, used, math.floor(used / 512 * 100), math.floor(os.clock() - Kernel.boot))
            task.wait(0.8)
        end
    end)
    refresh()
end

